{
  "name": "starquake-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:web && npm run build:dump",
    "build:web": "esbuild src/main.ts --bundle --format=iife --outfile=../viewer/bundle.js",
    "build:dump": "esbuild src/dump.ts --bundle --platform=node --format=cjs --outfile=../viewer/dump.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && tsx --test src/render.test.ts src/physics.test.ts src/world.test.ts src/entities.test.ts src/server.test.ts",
    "start": "tsx src/server.ts",
    "all": "npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
